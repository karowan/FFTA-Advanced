{
  "schema": 1,
  "timeoutSeconds": 1800,
  "scope": "Prerequisite readiness only. No VIK implementation acceptance until actual job tests are added.",
  "steps": [
    {
      "id": "worktree-prerequisites",
      "runtime": "python",
      "args": [
        "scripts/check-worktree-prerequisites.py"
      ],
      "suites": [
        "viking"
      ],
      "kind": "test"
    },
    {
      "id": "test-runner-self",
      "runtime": "python",
      "args": [
        "scripts/test-test-runner.py"
      ],
      "suites": [
        "viking"
      ],
      "kind": "test"
    },
    {
      "id": "test-installed-fell-original-executor",
      "runtime": "python",
      "args": [
        "scripts/test-exposed-native-executor.py",
        "--fell",
        "--current"
      ],
      "suites": [
        "viking"
      ],
      "kind": "test"
    },
    {
      "id": "build-samurai-private",
      "runtime": "python",
      "args": [
        "scripts/build-samurai-probe.py"
      ],
      "suites": [
        "viking"
      ],
      "kind": "prepare"
    },
    {
      "id": "prepare-samurai-executor",
      "runtime": "python",
      "args": [
        "scripts/prepare-samurai-executor.py"
      ],
      "suites": [
        "viking"
      ],
      "kind": "prepare",
      "requires": [
        "build-samurai-private",
        "test-installed-fell-original-executor"
      ]
    },
    {
      "id": "test-samurai-native",
      "runtime": "python",
      "args": [
        "scripts/test-samurai-native.py"
      ],
      "suites": [
        "viking"
      ],
      "kind": "test",
      "requires": [
        "prepare-samurai-executor"
      ]
    },
    {
      "id": "test-blade-ward-executor",
      "runtime": "python",
      "args": [
        "scripts/test-blade-ward-executor.py"
      ],
      "suites": [
        "viking"
      ],
      "kind": "test",
      "requires": [
        "prepare-samurai-executor"
      ]
    },
    {
      "id": "prepare-samurai-battle",
      "runtime": "python",
      "args": [
        "scripts/prepare-samurai-battle.py"
      ],
      "suites": [
        "viking"
      ],
      "kind": "prepare",
      "requires": [
        "build-samurai-private"
      ]
    }
  ]
}
